# Dados (grandes e potencialmente sensíveis: não versionar)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs de auditoria locais (mantemos apenas um exemplo em docs/)
audit_logs/*
!audit_logs/.gitkeep

# Saídas geradas
reports/*
!reports/.gitkeep

# IDE / SO
.vscode/
.idea/
.DS_Store
